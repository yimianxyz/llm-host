# B2: B1 with --max-num-batched-tokens 16384. B1 sized KV fine (494,080 tokens) but OOMed in warmup: FlashMLA FP8 sparse
# decode allocates ~8 GiB scaled by batched tokens x 64 DCP-gathered heads. 16384 halves it. B0 note: 111.3 GiB/GPU model.
# One flag per line as "--flag value"; "ENV NAME=value" lines become process env. Rationale: docs/DESIGN.md.
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--trust-remote-code
--tensor-parallel-size 4
--enable-expert-parallel
--kv-cache-dtype fp8_ds_mla
--gpu-memory-utilization 0.92
--max-model-len 262144
--max-num-batched-tokens 16384
--speculative-config {"method":"mtp","num_speculative_tokens":3}
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-per-request-metrics
--enable-auto-tool-choice
--tool-call-parser glm47
--reasoning-parser glm45
--decode-context-parallel-size 4
