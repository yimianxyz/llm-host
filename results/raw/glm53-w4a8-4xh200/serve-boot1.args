# B1: B0 + DCP4. B0 cannot boot: target+MTP draft take 111.3 GiB/GPU, leaving 6.71 GiB KV (131K tokens, replicated on every GPU).
# DCP4 shards KV by token across the 4 GPUs (~4x tokens) and all-gathers decode heads to 64 (no padding from 16).
# One flag per line as "--flag value"; "ENV NAME=value" lines become process env. Rationale: docs/DESIGN.md.
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--trust-remote-code
--tensor-parallel-size 4
--enable-expert-parallel
--kv-cache-dtype fp8_ds_mla
--gpu-memory-utilization 0.92
--max-model-len 262144
--max-num-batched-tokens 32768
--speculative-config {"method":"mtp","num_speculative_tokens":3}
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-per-request-metrics
--enable-auto-tool-choice
--tool-call-parser glm47
--reasoning-parser glm45
--decode-context-parallel-size 4
