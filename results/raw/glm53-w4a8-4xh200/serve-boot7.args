# B4: B2 with --max-num-batched-tokens 8192 (vLLM H200 default). The FlashMLA FP8 sparse mixed-batch buffer is ~256 KiB per
# batched token (8 GiB at 32K, 4 GiB at 16K) and is not memory-profiled; B2 OOMed on its first real 16K chunk (3.53 GiB free).
# One flag per line as "--flag value"; "ENV NAME=value" lines become process env. Rationale: docs/DESIGN.md.
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--trust-remote-code
--tensor-parallel-size 4
--enable-expert-parallel
--kv-cache-dtype fp8_ds_mla
--gpu-memory-utilization 0.92
--max-model-len 262144
--max-num-batched-tokens 8192
--speculative-config {"method":"mtp","num_speculative_tokens":3}
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-per-request-metrics
--enable-auto-tool-choice
--tool-call-parser glm47
--reasoning-parser glm45
--decode-context-parallel-size 4
