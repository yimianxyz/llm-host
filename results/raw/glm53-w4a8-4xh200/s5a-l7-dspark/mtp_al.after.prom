vllm:num_requests_running{engine="0",model_name="glm-5.3"} 0.0
# HELP vllm:num_requests_waiting Number of requests waiting to be processed.
# TYPE vllm:num_requests_waiting gauge
vllm:num_requests_waiting{engine="0",model_name="glm-5.3"} 0.0
# HELP vllm:num_requests_waiting_by_reason Number of waiting requests by reason. Reason labels: 'capacity' = waiting for scheduling capacity; 'deferred' = deferred by transient constraints (LoRA budget, KV transfer, blocked status). Sum of all reasons equals vllm:num_requests_waiting.
# TYPE vllm:num_requests_waiting_by_reason gauge
vllm:num_requests_waiting_by_reason{engine="0",model_name="glm-5.3",reason="capacity"} 0.0
vllm:num_requests_waiting_by_reason{engine="0",model_name="glm-5.3",reason="deferred"} 0.0
# HELP vllm:num_requests_kv_fetch_by_stage Number of waiting requests by async KV load stage. Stage labels: 'waiting_to_start' = needs an async KV load that has not started; 'in_progress' = load started and not yet reported finished; 'completed_waiting' = load finished, request not running yet.
# TYPE vllm:num_requests_kv_fetch_by_stage gauge
vllm:num_requests_kv_fetch_by_stage{engine="0",model_name="glm-5.3",stage="waiting_to_start"} 0.0
vllm:num_requests_kv_fetch_by_stage{engine="0",model_name="glm-5.3",stage="in_progress"} 0.0
vllm:num_requests_kv_fetch_by_stage{engine="0",model_name="glm-5.3",stage="completed_waiting"} 0.0
