# Copy to .env (gitignored) and fill in. deploy/pod.py and deploy/sync.sh read it.
# RunPod API key: https://console.runpod.io/user/settings (needed for runpodctl, SSH-key registration, REST fallback)
RUNPOD_API_KEY=
# Hugging Face read token: https://huggingface.co/settings/tokens (rate limits on the ~400 GB download; GPQA access)
HF_TOKEN=
# Key clients must send to the vLLM server (the RunPod proxy URL is public). Generate: openssl rand -hex 24
VLLM_API_KEY=
