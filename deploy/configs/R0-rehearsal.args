# R0: plumbing rehearsal on one cheap GPU. Same image and serving surface as B0, tiny model, no MoE/MTP flags.
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--max-model-len 32768
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-auto-tool-choice
--tool-call-parser hermes
--reasoning-parser qwen3
