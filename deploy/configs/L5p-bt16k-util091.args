# L5p: trade KV headroom for prefill throughput. B4 with 16K batched tokens (2x larger prefill chunks) and util 0.91, which
# leaves room for the 4 GiB unprofiled FlashMLA buffer that crashed B2 (3.53 GiB free at util 0.92). Expected KV ~0.8M tokens.
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--trust-remote-code
--tensor-parallel-size 4
--enable-expert-parallel
--kv-cache-dtype fp8_ds_mla
--gpu-memory-utilization 0.91
--max-model-len 262144
--max-num-batched-tokens 16384
--speculative-config {"method":"mtp","num_speculative_tokens":3}
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-per-request-metrics
--enable-auto-tool-choice
--tool-call-parser glm47
--reasoning-parser glm45
--decode-context-parallel-size 4
--profiler-config {"profiler":"torch","torch_profiler_dir":"/root/results/profile","torch_profiler_with_stack":false}
