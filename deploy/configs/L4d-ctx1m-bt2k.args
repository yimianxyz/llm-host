# L4, third attempt: the native 1M context at 2K prefill chunks. With L5c's graph cap the KV pool fits 1M (1,136,896
# tokens at util 0.92), but at 4K chunks the first request failed: "Tried to allocate 16.00 GiB ... 11.77 GiB is free".
# That is 4,096 tokens x 1,048,576 positions x 4 B, an unprofiled attention workspace sized by chunk x max-model-len.
# At 2K chunks it is 8 GiB. (A non-power-of-two 651,264 at 4K chunks died with an illegal memory access at init.)
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--trust-remote-code
--tensor-parallel-size 4
--enable-expert-parallel
--kv-cache-dtype fp8_ds_mla
--gpu-memory-utilization 0.92
--max-model-len 1048576
--max-num-batched-tokens 2048
--max-cudagraph-capture-size 128
--speculative-config {"method":"mtp","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,4,5],[5,16,3],[17,1024,1]]}
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-per-request-metrics
--enable-auto-tool-choice
--tool-call-parser glm47
--reasoning-parser glm45
--decode-context-parallel-size 4
--kv-offloading-size 300
--kv-offloading-backend native
--profiler-config {"profiler":"torch","torch_profiler_dir":"/root/results/profile","torch_profiler_with_stack":false}
