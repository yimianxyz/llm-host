# L2: B4 + native CPU KV offload (300 GiB total across ranks, of the pod's 755 GB cgroup RAM). Evicted prefixes
# are reloaded from host memory instead of re-prefilled; matters once sessions exceed the ~1.04M-token GPU KV pool.
--served-model-name glm-5.3
--host 0.0.0.0
--port 8000
--trust-remote-code
--tensor-parallel-size 4
--enable-expert-parallel
--kv-cache-dtype fp8_ds_mla
--gpu-memory-utilization 0.92
--max-model-len 262144
--max-num-batched-tokens 8192
--speculative-config {"method":"mtp","num_speculative_tokens":3}
--enable-prefix-caching
--enable-prompt-tokens-details
--enable-per-request-metrics
--enable-auto-tool-choice
--tool-call-parser glm47
--reasoning-parser glm45
--decode-context-parallel-size 4
--kv-offloading-size 300
--kv-offloading-backend native
